# Copy to .env and fill in. At least ONE search provider is required.
# Google Places (best for med spas / clinics): https://console.cloud.google.com -> enable "Places API (New)"
GOOGLE_PLACES_API_KEY=
# Serper.dev (Google search results, 2,500 free) — best for vendors/directories
SERPER_API_KEY=
# If both blank, falls back to DuckDuckGo (free, slower, rate-limited)

# Optional tuning
REQUEST_DELAY_SECONDS=1.5
MAX_PAGES_PER_SITE=6
HEADLESS=true
