# Copy this file to .env and fill in the keys you have. Every provider is
# optional and simply gets skipped by the scraper agent if unconfigured —
# but you need at least one search or directory provider for the agent to
# find anything.

# --- Search-API providers (find candidate company websites) ---
# Google Programmable Search Engine: https://programmablesearchengine.google.com/
# (create an engine set to "search the entire web") + an API key from
# https://console.cloud.google.com/apis/credentials
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# Serper.dev -- Google results, single API key, NO Google Cloud project or
# billing setup. Easiest option to get running: https://serper.dev/
SERPER_API_KEY=

# Brave Search API -- independent index, single API key, no Google Cloud.
# https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=

# Bing Web Search API (Azure Cognitive Services / Bing Search v7)
BING_SEARCH_API_KEY=

# --- Business directory API (optional second discovery source) ---
# Google Places API (New): enable "Places API (New)" at
# https://console.cloud.google.com/google/maps-apis. Best source for the
# city-based med_spa / clinic types (website + phone + address per result).
GOOGLE_PLACES_API_KEY=

# --- Keyless fallbacks ---
# With no search key at all, discovery falls back to DuckDuckGo (slow,
# rate-limited). Set to false to disable.
DUCKDUCKGO_FALLBACK=true
# JS-only / bot-challenge pages are re-fetched in headless Chromium when
# Playwright is installed (pip install playwright && playwright install chromium).
BROWSER_FALLBACK=true
# Optional: path to an existing Chromium binary for Playwright to use.
PLAYWRIGHT_CHROMIUM_PATH=

# --- CRM ---
# Defaults to a local SQLite file at ./data/leads.db if left blank.
DATABASE_URL=
FLASK_SECRET_KEY=change-me

# --- Scraper etiquette ---
# Identify yourself honestly, including a contact address, per common
# crawling etiquette (and so a site owner can reach you if they have an issue).
SCRAPER_USER_AGENT=PeptideLeadBot/0.1 (+contact: your-email@example.com)
REQUEST_TIMEOUT_SECONDS=10

# --- Outreach (emailer agent) ---
# Required before --send will deliver anything.
SENDER_NAME=Jonathan Cole
SENDER_EMAIL=
SENDER_COMPANY=
# CAN-SPAM: US commercial email must carry a real physical postal address
# and a working opt-out. Both are rendered into the message footer.
SENDER_POSTAL_ADDRESS=
UNSUBSCRIBE_LINE=Don't want to hear from us again? Reply with "unsubscribe" and we'll remove you.

# Follow-up cadence: first email, then one every N days until they reply.
FOLLOWUP_INTERVAL_DAYS=3
MAX_FOLLOWUPS=4

# Reply detection (IMAP, read-only). Without this, mark leads "replied" by
# hand in the CRM to stop their follow-ups.
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# SMTP delivery (only needed for --send; drafts mode needs none of this)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Pause between messages so a batch doesn't go out as a burst.
EMAIL_DELAY_SECONDS=8
